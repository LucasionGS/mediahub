# Fresh Debian 13 (trixie) with a sudo user, for testing setup.sh without touching a real machine
FROM debian:trixie
RUN apt-get update && apt-get install -y sudo git procps && \
  useradd -m -s /bin/bash hub && echo "hub ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/hub
COPY --chown=hub:hub . /home/hub/mediahub
USER hub
WORKDIR /home/hub/mediahub
CMD ["bash", "docker/test-setup.sh"]
